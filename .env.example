# OpenRouter API Key for Examination Question Generation
OPENROUTER_API_KEY=""

# OpenRouter Model
OPENROUTER_MODEL="openrouter/free"

# Security Secret Key (must be set to a secure unique random string in production)
SECRET_KEY="your-secure-jwt-secret-key-here"

# Initial Teacher Password (required for first-time account bootstrap if database is unseeded)
INITIAL_TEACHER_PASSWORD="your-strong-initial-password-here"

# Optional persistent data directory for SQLite database and rolling backups
# Set this to a persistent mount path (e.g. /mnt/examcraft-data on Cloud Run Filestore/GCS FUSE)
# EXAMCRAFT_DATA_DIR="/mnt/examcraft-data"

