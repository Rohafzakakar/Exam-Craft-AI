# Server Runtime Configuration
NODE_ENV="production"
PORT="3000"

# OpenRouter API Key for Examination Question Generation
OPENROUTER_API_KEY=""

# OpenRouter Model
OPENROUTER_MODEL="openrouter/free"

# Optional Gemini API Key
GEMINI_API_KEY=""

# Security Secret Key (REQUIRED in production: set to a strong unique random string)
SECRET_KEY="your-secure-jwt-secret-key-here"

# Initial Teacher Password (optional: seeds primary teacher account on first empty DB startup)
INITIAL_TEACHER_PASSWORD="your-strong-initial-password-here"

# Persistent data directory for SQLite database, rolling backups, and uploads
# Local development default: ./data
# Docker / Cloud Run default: /app/data (mount a writable Cloud Run volume here for persistence)
EXAMCRAFT_DATA_DIR="/app/data"

